# Copy this file to server/.env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=print_repository
DB_USER=postgres
DB_PASSWORD=your_database_password

# JWT Configuration (required - the server will not start without JWT_SECRET)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Password for the first "admin" user. Only used when no admin exists yet.
ADMIN_INITIAL_PASSWORD=

# Server Configuration
PORT=5001
NODE_ENV=development
# Frontend URL, needed in production so the API accepts its requests
CLIENT_ORIGIN=

# Failed login attempts allowed per IP address every 15 minutes
AUTH_RATE_LIMIT_MAX=20

# File Upload Configuration
MAX_FILE_SIZE=26214400
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png
UPLOAD_PATH=uploads
